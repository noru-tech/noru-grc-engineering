{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/noru-tech/noru-grc-engineering/contract/governance-records.schema.json",
  "title": "Noru governance records manifest (.noru/governance-records.yml)",
  "description": "The records half of governance: minutes, scope statements, applicability statements, audit plans and reports, findings and corrective action plans — each one an assertion that named people met, decided, or approved something on a date. The queue half is a snapshot of what Noru said was unmet; the records half is what a human proposes to file against it. Enforced by plugins/governance-records/scripts/validate_manifest.py.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "piece", "source", "queue_snapshot", "records"],
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "piece": { "const": "governance-records" },
    "source": { "$ref": "#/$defs/source" },
    "queue_snapshot": {
      "description": "What Noru's own catalogue said was unmet, at the moment :scan ran. Written from MCP output by the client; never invented by this plugin. Requirement 9.",
      "type": "object",
      "additionalProperties": false,
      "required": ["fetched_at", "via", "controls"],
      "properties": {
        "fetched_at": { "type": "string", "minLength": 10 },
        "via": {
          "description": "The MCP tools the snapshot came from.",
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "getOrganizationControls",
              "getPendingControls",
              "getControlContext",
              "getEvidenceItems",
              "getEvidenceForControl"
            ]
          }
        },
        "controls": { "type": "array", "items": { "$ref": "#/$defs/queueControl" } }
      }
    },
    "records": { "type": "array", "items": { "$ref": "#/$defs/record" } }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "commit_sha", "branch", "generated_by"],
      "properties": {
        "slug": { "type": "string", "minLength": 1 },
        "commit_sha": { "type": "string", "minLength": 7 },
        "branch": { "type": "string", "minLength": 1 },
        "generated_by": { "type": "string", "minLength": 1 },
        "derived_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "ref": { "type": "string", "pattern": "^[^:\\s][^:]*:[0-9]+$" },
    "interpretation": {
      "description": "Contract requirement 8. For this piece the claim being attributed is 'this record is a true account of what was decided, and it satisfies this catalogue expectation'. expires_at may be omitted only when the record carries next_review_due instead — a governance obligation is legitimately point-in-time on a review cadence, but it is never open-ended.",
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "decided_at", "rationale"],
      "properties": {
        "owner": { "type": "string", "minLength": 3 },
        "decided_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "expires_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "rationale": { "type": "string", "minLength": 10 },
        "refs": { "type": "array", "items": { "$ref": "#/$defs/ref" } }
      }
    },
    "queueControl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["control_id", "unmet_evidence_items"],
      "properties": {
        "control_id": {
          "description": "The canonical lowercase internal control id returned as `id` by getOrganizationControls. `controlId` is the uppercase display form; store the canonical one.",
          "type": "string",
          "minLength": 1
        },
        "display_id": { "type": "string" },
        "name": { "type": "string" },
        "status": { "type": "string" },
        "coverage": { "type": "number" },
        "unmet_evidence_items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "title": { "type": "string", "minLength": 1 },
              "type": { "type": "string" }
            }
          }
        },
        "testing_guidance_available": {
          "description": "Whether getControlContext returned testing guidance for this control. The guidance text itself is deliberately not stored: it is the API's to serve, not ours to vendor.",
          "type": "boolean"
        }
      }
    },
    "participant": {
      "description": "A named human who was in the room. A record of a decision with nobody in it is not a record of a decision.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 2 },
        "role": { "type": "string" },
        "attendance": { "enum": ["present", "apologies", "delegate"] }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "owner"],
      "properties": {
        "description": { "type": "string", "minLength": 5 },
        "owner": { "type": "string", "minLength": 3 },
        "due_on": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "status": { "enum": ["open", "in_progress", "done", "cancelled"] }
      }
    },
    "controlMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["control_id"],
      "properties": {
        "control_id": { "type": "string", "minLength": 1 },
        "evidence_item_ids": {
          "description": "Omit or leave empty for a generic control-level link; name the catalogue items to satisfy a specific expectation.",
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "kind",
        "title",
        "occurred_on",
        "document",
        "refs",
        "control_mappings",
        "interpretation"
      ],
      "properties": {
        "key": {
          "description": "Stable identity for this record across re-scans. Changing it creates a second evidence record in Noru, so treat it as permanent.",
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "kind": {
          "enum": [
            "steering_committee_minutes",
            "management_review_minutes",
            "board_minutes",
            "audit_committee_minutes",
            "risk_committee_minutes",
            "isms_scope",
            "statement_of_applicability",
            "internal_audit_plan",
            "internal_audit_report",
            "internal_audit_checklist",
            "finding_record",
            "corrective_action_plan",
            "decision_record"
          ]
        },
        "title": { "type": "string", "minLength": 1 },
        "occurred_on": {
          "description": "When the meeting was held, or the document was issued. The date an auditor asks for.",
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "approved_on": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "approved_by": { "type": "string", "minLength": 3 },
        "next_review_due": {
          "description": "When this record must be produced again. The alternative to interpretation.expires_at for a point-in-time governance obligation on a cadence.",
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "document": {
          "description": "The source document this record was read from. Its digest ties the record to a file whose bytes can be checked; the file itself belongs in a document store or a file upload, not in this manifest.",
          "type": "object",
          "additionalProperties": false,
          "required": ["file", "sha256"],
          "properties": {
            "file": { "type": "string", "minLength": 1 },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "size_bytes": { "type": "integer", "minimum": 1 }
          }
        },
        "participants": { "type": "array", "items": { "$ref": "#/$defs/participant" } },
        "decisions": { "type": "array", "items": { "type": "string", "minLength": 5 } },
        "actions": { "type": "array", "items": { "$ref": "#/$defs/action" } },
        "refs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ref" } },
        "control_mappings": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/controlMapping" }
        },
        "interpretation": { "$ref": "#/$defs/interpretation" },
        "needs_review": { "type": "boolean" }
      }
    }
  }
}
