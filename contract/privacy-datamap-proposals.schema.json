{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/noru-tech/noru-grc-engineering/contract/privacy-datamap-proposals.schema.json",
  "title": "Noru privacy data-map non-authoritative agent proposal queue",
  "description": "Cache-only work selected by the deterministic reconciler. Entries are suggestions and cannot update the accepted manifest or lock by themselves.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "piece",
    "observation_digest",
    "proposals",
    "system_proposals",
    "store_investigation",
    "analysis_binding"
  ],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "piece": {
      "const": "privacy-datamap"
    },
    "observation_digest": {
      "$ref": "#/$defs/digest"
    },
    "system_proposals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/system_proposal"
      }
    },
    "store_investigation": {
      "$ref": "#/$defs/store_investigation"
    },
    "proposals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/proposal"
      }
    },
    "reasoning_groups": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/reasoning_group"
      }
    },
    "structural_errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "detail",
          "resolution_needed"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "resolution_needed": {
            "type": "string"
          }
        }
      }
    },
    "decisions": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/decision"
      }
    },
    "dependency_proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "entity_id": {
            "type": "string"
          },
          "observation_digest": {
            "type": "string"
          },
          "outcome": {
            "enum": [
              null,
              "retain",
              "amend",
              "unresolved"
            ]
          },
          "decision_summary": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          },
          "confidence": {
            "enum": [
              null,
              "low",
              "medium",
              "high"
            ]
          },
          "refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "unresolved_question": {
            "type": "string"
          },
          "resolution_needed": {
            "type": "string"
          },
          "decision_impact": {
            "type": "string"
          }
        }
      }
    },
    "analysis_binding": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relationship_proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "graph",
        "evidence_dependencies",
        "decision_summary"
      ],
      "properties": {
        "graph": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "nodes",
            "edges"
          ],
          "properties": {
            "nodes": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "kind"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*$"
                  },
                  "kind": {
                    "enum": [
                      "runtime",
                      "client",
                      "connection",
                      "datastore",
                      "schema",
                      "payload"
                    ]
                  },
                  "key": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*$"
                  },
                  "paths": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "unresolved_question": {
                    "type": "string",
                    "minLength": 1
                  },
                  "resolution_needed": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "edges": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "source",
                  "target",
                  "dependencies",
                  "rationale",
                  "confidence"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*$"
                  },
                  "source": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*$"
                  },
                  "target": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]*$"
                  },
                  "dependencies": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "rationale": {
                    "type": "string",
                    "minLength": 1
                  },
                  "confidence": {
                    "enum": [
                      "low",
                      "medium",
                      "high"
                    ]
                  }
                }
              }
            }
          }
        },
        "evidence_dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "path",
              "method",
              "targets",
              "fingerprint"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "method": {
                "enum": [
                  "python_ast",
                  "typescript_ast",
                  "json",
                  "text"
                ]
              },
              "selector": {
                "type": "string"
              },
              "targets": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "fingerprint": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        "decision_summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        }
      },
      "description": "Complete proposed graph for collect.mjs --candidate. Evidence must validate before collecting corrected observations; this does not accept the graph."
    },
    "evidence_dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "method",
          "targets",
          "fingerprint"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "method": {
            "enum": [
              "python_ast",
              "typescript_ast",
              "json",
              "text"
            ]
          },
          "selector": {
            "type": "string"
          },
          "targets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "fingerprint": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "evidence_state": {
      "type": "object"
    },
    "discovery_state": {
      "type": "object"
    },
    "discovery_proposals": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "discovery_required": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "retired_analysis": {
      "type": "object"
    }
  },
  "$defs": {
    "system_proposal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rationale": {
          "type": "string"
        },
        "confidence": {
          "enum": [
            null,
            "low",
            "medium",
            "high"
          ]
        },
        "refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "entity_id": {
          "type": "string"
        },
        "processing_activities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/processing_activity"
          }
        }
      }
    },
    "store_investigation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rationale": {
          "type": "string"
        },
        "confidence": {
          "enum": [
            null,
            "low",
            "medium",
            "high"
          ]
        },
        "refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "search_scope": {
          "type": "string"
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/store_finding"
          }
        }
      }
    },
    "store_finding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rationale": {
          "type": "string"
        },
        "confidence": {
          "enum": [
            null,
            "low",
            "medium",
            "high"
          ]
        },
        "refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "store": {
          "type": "string"
        },
        "status": {
          "enum": [
            "covered",
            "gap"
          ]
        },
        "dataset_reference": {
          "type": "string"
        },
        "unresolved_question": {
          "type": "string"
        },
        "resolution_needed": {
          "type": "string"
        },
        "decision_summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^[^\\n]+$"
        },
        "decision_impact": {
          "type": "string"
        }
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_id",
        "dataset",
        "collection",
        "field",
        "shape",
        "refs",
        "observation_digest",
        "reason",
        "proposal_kind",
        "proposed_categories",
        "rationale",
        "confidence",
        "status"
      ],
      "properties": {
        "entity_id": {
          "type": "string",
          "minLength": 3
        },
        "dataset": {
          "type": "string"
        },
        "collection": {
          "type": "string",
          "minLength": 1
        },
        "field": {
          "type": "string",
          "minLength": 1
        },
        "shape": {
          "type": "string"
        },
        "refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[^:\\s][^:]*:[0-9]+$"
          }
        },
        "observation_digest": {
          "$ref": "#/$defs/digest"
        },
        "reason": {
          "enum": [
            "new field",
            "materially changed field"
          ]
        },
        "proposal_kind": {
          "description": "Agent-authored semantic proposal. Null means the deterministic reconciler requested analysis but no proposal has been made.",
          "enum": [
            null,
            "personal",
            "non_personal",
            "ambiguous",
            "special_category"
          ]
        },
        "proposed_categories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rationale": {
          "type": "string"
        },
        "confidence": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "requested",
            "proposed",
            "rejected",
            "accepted"
          ]
        },
        "unresolved_question": {
          "type": "string"
        },
        "analysis": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schema": {
              "type": "string"
            },
            "relationships": {
              "type": "string"
            },
            "service_or_serialization": {
              "type": "string"
            }
          }
        },
        "reasoning_group": {
          "type": "string"
        },
        "resolution_needed": {
          "type": "string"
        },
        "decision_id": {
          "type": "string"
        },
        "decision_impact": {
          "type": "string"
        }
      }
    },
    "processing_activity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rationale": {
          "type": "string"
        },
        "confidence": {
          "enum": [
            null,
            "low",
            "medium",
            "high"
          ]
        },
        "refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "purpose": {
          "type": "string"
        },
        "proposed_data_uses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "proposed_data_subjects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dataset_references": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "relationship_rationale": {
          "type": "string"
        },
        "business_context_question": {
          "type": "string"
        },
        "unresolved_question": {
          "type": "string"
        },
        "activity_id": {
          "type": "string"
        },
        "resolution_needed": {
          "type": "string"
        },
        "decision_summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^[^\\n]+$"
        },
        "decision_impact": {
          "type": "string"
        }
      },
      "required": [
        "rationale",
        "confidence",
        "refs",
        "purpose",
        "proposed_data_uses",
        "proposed_data_subjects",
        "dataset_references",
        "relationship_rationale",
        "activity_id",
        "decision_summary"
      ]
    },
    "reasoning_group": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rationale": {
          "type": "string"
        },
        "confidence": {
          "type": [
            "string",
            "null"
          ]
        },
        "refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[^:\\s][^:]*:[0-9]+$"
          }
        },
        "analysis": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schema": {
              "type": "string"
            },
            "relationships": {
              "type": "string"
            },
            "service_or_serialization": {
              "type": "string"
            }
          }
        },
        "unresolved_question": {
          "type": "string"
        },
        "resolution_needed": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "decision_impact": {
          "type": "string"
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_summary"
      ],
      "properties": {
        "decision_summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^[^\\n]+$"
        },
        "unresolved_question": {
          "type": "string"
        },
        "resolution_needed": {
          "type": "string"
        },
        "decision_impact": {
          "type": "string"
        }
      }
    }
  }
}
