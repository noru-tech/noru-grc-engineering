{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/noru-tech/noru-grc-engineering/contract/privacy-datamap-review.schema.json",
  "title": "Privacy scan data map, review queue and evidence record",
  "description": "On-demand review views. Proposed meaning never constitutes acceptance. Markdown renders data_map and review_queue; explicit evidence JSON output includes all three without persisting a duplicate inventory.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "status",
    "observation_digest",
    "data_map",
    "review_queue",
    "evidence_record",
    "collection_mode",
    "progress"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "status": {
      "enum": [
        "enrichment incomplete",
        "ready for human review",
        "accepted"
      ]
    },
    "observation_digest": {
      "type": "string"
    },
    "data_map": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stores",
        "processing_activities"
      ],
      "properties": {
        "stores": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "collections",
              "data_categories",
              "field_count"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "collections": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "data_categories": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "field_count": {
                "type": "integer"
              }
            }
          }
        },
        "processing_activities": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "monitoring_scope": {
          "type": "object"
        },
        "connection_questions": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "relationship_proposal": {
          "type": [
            "object",
            "null"
          ]
        },
        "system_flows": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "dotnet": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "projects": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "solutions": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "technologies": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "relationships": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "diagnostic_summary": {
              "type": "object"
            },
            "runtime_bindings": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "entity_relationships": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "gaps": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "review_queue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "structural_blockers",
        "analysis_errors",
        "changes",
        "collection_decisions",
        "field_groups",
        "technical_coverage",
        "processing_decisions"
      ],
      "properties": {
        "structural_blockers": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "analysis_errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "changes": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "collection_decisions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "field_groups": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "decision_id",
              "collections",
              "summary",
              "proposal_kinds",
              "data_categories",
              "unresolved_question",
              "resolution_needed",
              "decision_impact",
              "field_ids"
            ]
          }
        },
        "technical_coverage": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "processing_decisions": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "dependency_decisions": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "control_changes": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "system_changes": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "evidence_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fields",
        "reasoning_groups",
        "agent_analysis",
        "candidate_manifest",
        "coverage",
        "special_category_refs"
      ],
      "properties": {
        "fields": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "reasoning_groups": {
          "type": "object"
        },
        "agent_analysis": {
          "type": "object"
        },
        "candidate_manifest": {
          "type": "object"
        },
        "coverage": {
          "type": "object"
        },
        "special_category_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reconciliation": {
          "type": "object"
        },
        "relationship_mapping": {
          "type": "object"
        },
        "extraction_diagnostics": {
          "type": "object",
          "required": [
            "version",
            "observed_diagnostics",
            "resolved_diagnostics",
            "active_blockers"
          ],
          "properties": {
            "version": {
              "const": 1
            },
            "observed_diagnostics": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "resolved_diagnostics": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "active_blockers": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "collection_mode": {
      "enum": [
        "manifest",
        "candidate"
      ],
      "description": "Whether reviewed observations use manifest bindings or a separately validated proposed graph."
    },
    "progress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "collection",
        "agent_investigation",
        "agent_pending_fields",
        "extraction_gaps",
        "source_information",
        "missing_facts",
        "human_approval",
        "publication",
        "next_actions"
      ],
      "properties": {
        "collection": {
          "type": "string"
        },
        "agent_investigation": {
          "type": "string"
        },
        "source_information": {
          "type": "string"
        },
        "human_approval": {
          "type": "string"
        },
        "publication": {
          "type": "string"
        },
        "agent_pending_fields": {
          "type": "integer",
          "minimum": 0
        },
        "extraction_gaps": {
          "type": "integer",
          "minimum": 0
        },
        "missing_facts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "next_actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "technical_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "accepted_uncertainty_count": {
          "type": "integer",
          "minimum": 0
        },
        "accepted_uncertainties": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    }
  }
}
