{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/noru-tech/noru-grc-engineering/contract/privacy-datamap-lock.schema.json",
  "title": "Noru privacy data-map accepted observation lock",
  "description": "Accepted structural observations and compact privacy meaning used to detect changes; the manifest remains authoritative.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "piece",
    "source",
    "taxonomy_digest",
    "accepted_manifest_sha256",
    "collections",
    "entities"
  ],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "piece": {
      "const": "privacy-datamap"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug",
        "derived_digest"
      ],
      "properties": {
        "slug": {
          "type": "string",
          "minLength": 1
        },
        "derived_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "taxonomy_digest": {
      "$ref": "#/$defs/digest"
    },
    "accepted_manifest_sha256": {
      "$ref": "#/$defs/digest"
    },
    "collections": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/observation"
      }
    },
    "entities": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/entity"
      }
    },
    "observation_format": {
      "const": "structural-v2"
    },
    "systems": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    },
    "discovery_sources": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    },
    "system_flows": {
      "type": "object"
    },
    "semantic_snapshot": {
      "type": "object",
      "required": [
        "fields",
        "collections",
        "activities"
      ],
      "additionalProperties": false,
      "properties": {
        "fields": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "collections": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "activities": {
          "type": "object",
          "additionalProperties": {
            "type": "object"
          }
        }
      }
    },
    "classification_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "policy_digest",
        "structural_digest",
        "source_inventory_digest",
        "inventory_digest",
        "manifest_semantics_digest",
        "gap_inventory_digest"
      ],
      "properties": {
        "version": {
          "const": 2
        },
        "policy_digest": {
          "$ref": "#/$defs/digest"
        },
        "structural_digest": {
          "$ref": "#/$defs/digest"
        },
        "source_inventory_digest": {
          "$ref": "#/$defs/digest"
        },
        "inventory_digest": {
          "$ref": "#/$defs/digest"
        },
        "manifest_semantics_digest": {
          "$ref": "#/$defs/digest"
        },
        "migration_exclusions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "paths": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "roots": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "support_paths": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "gap_inventory_digest": {
          "$ref": "#/$defs/digest"
        },
        "shape_observations": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "entity_id",
              "base_observation_digest",
              "rationale",
              "structure",
              "binding"
            ],
            "properties": {
              "entity_id": {
                "type": "string"
              },
              "base_observation_digest": {
                "type": "string"
              },
              "rationale": {
                "type": "string"
              },
              "structure": {
                "type": "object"
              },
              "binding": {
                "type": "object"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "ref": {
      "type": "string",
      "pattern": "^[^:\\s][^:]*:[0-9]+$"
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic_digest",
        "refs"
      ],
      "properties": {
        "semantic_digest": {
          "$ref": "#/$defs/digest"
        },
        "refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ref"
          }
        }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "shape",
        "semantic_digest",
        "refs"
      ],
      "properties": {
        "kind": {
          "const": "field"
        },
        "shape": {
          "type": "string"
        },
        "semantic_digest": {
          "$ref": "#/$defs/digest"
        },
        "refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ref"
          }
        }
      }
    }
  }
}
