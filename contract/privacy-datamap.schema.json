{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/noru-tech/noru-grc-engineering/contract/privacy-datamap.schema.json",
  "title": "Noru Privacy Datamap manifest (.noru/privacy-datamap.yml)",
  "description": "A Fideslang data map for one repository, plus the bookkeeping that makes it reviewable: a file:line citation behind every claim, an interpretation block naming who stands behind each collection and each privacy declaration, and needs_review flags the collector sets on anything it could not resolve. The bookkeeping is stripped before the map is sent to Noru or rendered to .fides/datamap.yml \u2014 it exists for the pull request, not for the wire.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "piece",
    "source",
    "dataset",
    "system"
  ],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "piece": {
      "const": "privacy-datamap"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "dataset": {
      "description": "One dataset per logical store. Collections are tables or models; fields are columns or attributes.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/dataset"
      }
    },
    "system": {
      "description": "One system per deployable service, with a privacy declaration per distinct purpose.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/system"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug",
        "commit_sha",
        "branch",
        "generated_by"
      ],
      "properties": {
        "slug": {
          "type": "string",
          "minLength": 1
        },
        "commit_sha": {
          "type": "string",
          "minLength": 7
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "generated_by": {
          "type": "string",
          "minLength": 1
        },
        "derived_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "ref": {
      "type": "string",
      "pattern": "^[^:\\s][^:]*:[0-9]+$"
    },
    "interpretation": {
      "description": "Contract requirement 8. Who decided this, when, until when, and why. A claim without one is a validator error.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "decided_at",
        "rationale"
      ],
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 3
        },
        "decided_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "expires_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "rationale": {
          "type": "string",
          "minLength": 10
        },
        "refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ref"
          }
        }
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fides_key",
        "name",
        "collections"
      ],
      "properties": {
        "fides_key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.<>-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "collections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/collection"
          }
        }
      }
    },
    "collection": {
      "description": "The claim unit. One interpretation block covers the whole collection: per-field attribution would be five hundred blocks on a five-hundred-column schema, which is a form nobody fills in.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "refs",
        "structure_digest",
        "fields"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ref"
          }
        },
        "interpretation": {
          "$ref": "#/$defs/interpretation"
        },
        "needs_review": {
          "type": "boolean"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field"
          }
        },
        "structure_digest": {
          "description": "sha256 of this collection's sorted, dotted field NAMES \u2014 not their categories. Resolving a classification keeps the signature; adding, removing or renaming a column breaks it. This is the structural anchor in contract/README.md requirement 8: it pins what a signature was given for, which is what lets this piece anchor its expiry on decided_at honestly.",
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "refs"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "data_categories": {
          "description": "Fideslang data category keys, checked against the bundled snapshot in contract/lib/taxonomy/. An empty list means the field was considered and holds no personal data \u2014 which is not the same as a field nobody looked at, and is why needs_review exists.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ref"
          }
        },
        "needs_review": {
          "type": "boolean"
        },
        "fields": {
          "description": "Nested fields: a JSON column, an embedded document, a protobuf sub-message.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/field"
          }
        }
      }
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fides_key",
        "name",
        "privacy_declarations"
      ],
      "properties": {
        "fides_key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.<>-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "system_type": {
          "type": "string"
        },
        "dataset_references": {
          "description": "fides_key values of datasets defined in this same manifest. A reference to anything else is a dangling edge in the map.",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.<>-]+$"
          }
        },
        "privacy_declarations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/declaration"
          }
        }
      }
    },
    "declaration": {
      "description": "A purpose, and what it processes. The join that binds a data use to the categories and subjects it touches.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "data_use",
        "data_subjects",
        "refs"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "data_use": {
          "type": "string",
          "minLength": 1
        },
        "data_subjects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "data_categories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ref"
          }
        },
        "interpretation": {
          "$ref": "#/$defs/interpretation"
        },
        "needs_review": {
          "type": "boolean"
        }
      }
    }
  }
}
