{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/noru-tech/noru-grc-engineering/contract/privacy-datamap.schema.json",
  "title": "Noru Privacy Datamap manifest (.noru/privacy-datamap.yml)",
  "description": "A Fideslang data map for one repository, plus the bookkeeping that makes it reviewable: a file:line citation behind every claim, an interpretation block naming who stands behind each collection and each privacy declaration, and needs_review flags the collector sets on anything it could not resolve. The bookkeeping is stripped before the map is sent to Noru or rendered to .fides/datamap.yml \u2014 it exists for the pull request, not for the wire.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "piece",
    "source",
    "dataset",
    "system"
  ],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "piece": {
      "const": "privacy-datamap"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "dataset": {
      "description": "One dataset per normalized logical store, independent of how many declarative schema or migration files provide its structural evidence. Collections are current tables or models; fields are current columns or attributes.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/dataset"
      }
    },
    "system": {
      "description": "One system per deployable service, with a privacy declaration per distinct purpose.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/system"
      }
    },
    "evidence_dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "method",
          "targets",
          "fingerprint"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "method": {
            "enum": [
              "python_ast",
              "typescript_ast",
              "json",
              "text"
            ]
          },
          "selector": {
            "type": "string"
          },
          "targets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "fingerprint": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "relationship_graph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodes",
        "edges"
      ],
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "kind": {
                "enum": [
                  "runtime",
                  "client",
                  "connection",
                  "datastore",
                  "schema",
                  "payload"
                ]
              },
              "key": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "paths": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "unresolved_question": {
                "type": "string",
                "minLength": 1
              },
              "resolution_needed": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "source",
              "target",
              "dependencies",
              "rationale",
              "confidence"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "source": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "target": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "dependencies": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              },
              "confidence": {
                "enum": [
                  "low",
                  "medium",
                  "high"
                ]
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug",
        "commit_sha",
        "branch",
        "generated_by"
      ],
      "properties": {
        "slug": {
          "type": "string",
          "minLength": 1
        },
        "commit_sha": {
          "type": "string",
          "minLength": 7
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "generated_by": {
          "type": "string",
          "minLength": 1
        },
        "derived_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "ref": {
      "type": "string",
      "pattern": "^[^:\\s][^:]*:[0-9]+$"
    },
    "interpretation": {
      "description": "Contract requirement 8. Who decided this, when, until when, and why. A claim without one is a validator error.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "decided_at",
        "rationale"
      ],
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 3
        },
        "decided_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "expires_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "rationale": {
          "type": "string",
          "minLength": 10
        },
        "refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ref"
          }
        }
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fides_key",
        "name",
        "collections"
      ],
      "properties": {
        "fides_key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.<>-]+$"
        },
        "name": {
          "description": "Human-readable logical datastore boundary, not an individual source filename.",
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "collections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/collection"
          }
        }
      }
    },
    "collection": {
      "description": "The claim unit. Newly observed fields remain visible through review; accepted non-personal fields are recorded compactly by name. One interpretation block covers the whole collection.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "refs",
        "structure_digest",
        "fields"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "refs": {
          "description": "Every file-and-line reference contributing to this normalized current collection.",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ref"
          }
        },
        "interpretation": {
          "$ref": "#/$defs/interpretation"
        },
        "needs_review": {
          "type": "boolean"
        },
        "fields": {
          "description": "Privacy-relevant fields, unresolved fields, and parent fields needed to retain categorized nested children.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/field"
          }
        },
        "non_personal_fields": {
          "description": "Sorted dotted field names accepted as non-personal during collection review. Their complete shapes and citations remain in derived facts and the accepted observation lock.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "structure_digest": {
          "description": "sha256 of the union of sorted, dotted field names in fields and non_personal_fields \u2014 not their categories. Resolving a classification or moving a name between the two representations keeps the signature; adding, removing or renaming a column breaks it. This is the structural anchor in contract/README.md requirement 8.",
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "refs"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "data_categories": {
          "description": "Fideslang data category keys, checked against the bundled snapshot in contract/lib/taxonomy/. Generated manifests use non_personal_fields instead of a full field object when this list would be empty; needs_review distinguishes unresolved fields.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "refs": {
          "description": "Every file-and-line reference contributing to this normalized current field, including supported migration operations retained through rename replay.",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ref"
          }
        },
        "needs_review": {
          "type": "boolean"
        },
        "fields": {
          "description": "Nested fields: a JSON column, an embedded document, a protobuf sub-message.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/field"
          }
        }
      }
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fides_key",
        "name",
        "privacy_declarations"
      ],
      "properties": {
        "fides_key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.<>-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "system_type": {
          "type": "string"
        },
        "dataset_references": {
          "description": "fides_key values of datasets defined in this same manifest. A reference to anything else is a dangling edge in the map.",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.<>-]+$"
          }
        },
        "privacy_declarations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/declaration"
          }
        }
      }
    },
    "declaration": {
      "description": "A purpose, and what it processes. The join that binds a data use to the categories and subjects it touches.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "data_use",
        "data_subjects",
        "refs"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "data_use": {
          "type": "string",
          "minLength": 1
        },
        "data_subjects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "data_categories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ref"
          }
        },
        "interpretation": {
          "$ref": "#/$defs/interpretation"
        },
        "needs_review": {
          "type": "boolean"
        }
      }
    }
  }
}
