{
  "inputs": [
    {
      "type": "promptString",
      "id": "tickets-key",
      "description": "Tickets API key",
      "password": true
    }
  ],
  "servers": {
    "tickets": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@example/tickets-mcp"],
      "env": {
        "TICKETS_TOKEN": "${input:tickets-key}"
      }
    }
  }
}
