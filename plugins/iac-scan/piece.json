      "valid": [
        "fixtures/valid.iac-scan.yml"
      ],
      "invalid": [
        {
          "path": "fixtures/invalid-missing-interpretation.iac-scan.yml",
          "expect_message": "missing required `interpretation`"
        },
        {
          "path": "fixtures/invalid-unknown-kind.iac-scan.yml",
          "expect_message": "unknown item kind"
        }
      ]
    }
  },
  "push": {
    "entrypoint": "scripts/push.mjs",
    "mode": "keyed_upsert",
    "collapses_to": {
